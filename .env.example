# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration
# These are configured in Supabase Auth settings
# 1. Go to Supabase Dashboard > Authentication > Providers
# 2. Enable Google provider
# 3. Add authorized redirect URL: https://your-project.supabase.co/auth/v1/callback
# 4. Configure Google OAuth consent screen: https://console.cloud.google.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Server-side only - DO NOT expose client-side)
# Only use this in server-side code for admin operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notes:
# - NEVER commit .env files with real credentials
# - NEXT_PUBLIC_ prefix exposes variables to the browser
# - Service role key bypasses RLS - use only server-side
# - For production, set these in your hosting platform's environment variables
