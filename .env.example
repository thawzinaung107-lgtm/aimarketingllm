# Copy to .env.local for development. NEVER commit real values.
# Separate Supabase projects (and keys) are expected for development,
# staging and production; set these in each environment's secret store.

# --- Public (exposed to the browser) ----------------------------------------
# Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Base URL of this app for the environment (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Secret key: bypasses RLS. Used only server-side to mint short-lived signed
# video URLs after the database has authorised access.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Private Storage bucket holding lesson videos
LESSON_VIDEO_BUCKET=lesson-videos
# Lifetime of signed playback URLs, in seconds (30-3600)
SIGNED_URL_TTL_SECONDS=300

# --- Local Supabase only: Google OAuth for `supabase start` -----------------
# Read by supabase/config.toml ([auth.external.google]). See SETUP_GOOGLE_OAUTH.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
